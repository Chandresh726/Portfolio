{
	"name": "chandresh-portfolio",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=26.13.1 <27"
	},
	"type": "module",
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build --webpack",
		"start": "next start",
		"assets:generate": "node scripts/generate-assets.mjs",
		"analyze:build": "node scripts/measure-build.mjs",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"knip": "knip --reporter compact",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm peers check && pnpm audit --audit-level low && pnpm build",
		"format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json,yml,yaml}' --config ./.prettierrc",
		"format:check": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,json,yml,yaml}' --config ./.prettierrc"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.1.0",
		"clsx": "^2.1.1",
		"framer-motion": "^14.14.0",
		"lottie-react": "^3.1.2",
		"lucide-react": "^1.78.0",
		"next": "^16.4.6",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"tailwind-merge": "^3.7.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.4.6",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^31.0.1",
		"knip": "^6.48.0",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
