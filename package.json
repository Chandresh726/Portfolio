{
	"name": "chandresh-portfolio",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24.11.0 <25"
	},
	"type": "module",
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build --webpack",
		"start": "next start",
		"assets:generate": "node scripts/generate-assets.mjs",
		"analyze:build": "node scripts/measure-build.mjs",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"knip": "knip --reporter compact",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm peers check && pnpm audit --audit-level low && pnpm build",
		"format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json,yml,yaml}' --config ./.prettierrc",
		"format:check": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,json,yml,yaml}' --config ./.prettierrc"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.19",
		"@radix-ui/react-separator": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.12",
		"@tailwindcss/postcss": "^4.3.2",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.42.2",
		"lottie-react": "^2.4.1",
		"lucide-react": "^1.24.0",
		"next": "^16.2.10",
		"next-themes": "^0.4.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-icons": "^5.7.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.2.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"eslint": "^10.7.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^29.1.1",
		"knip": "^6.26.0",
		"postcss": "^8.5.18",
		"prettier": "^3.9.5",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	}
}
